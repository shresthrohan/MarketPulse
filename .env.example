# MarketPulse — local development configuration. Copy to .env (git-ignored) and change the password.
# Production uses deploy/.env.production.example instead (see docs/deployment.md).
# Values embedded in URLs (passwords) must be URL-safe: use letters and digits.

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=marketpulse

# --- Market data providers (comma-separated, run side by side) ---
#   simulator     simulated US equities/ETFs, no credentials (labelled SIMULATED everywhere)
#   binance       live crypto pairs from Binance public streams, no credentials (labelled LIVE)
#   finnhub_ws    live US equity trades from Finnhub (needs FINNHUB_API_KEY; replaces the simulator)
#   finnhub_rest  polled Finnhub quotes, labelled DELAYED (needs FINNHUB_API_KEY; replaces the simulator)
# An instrument never mixes simulated and real data: switching equities from the simulator to Finnhub
# needs a fresh database (docs/deployment.md, "Switching data sources").
PROVIDERS=simulator,binance
FINNHUB_API_KEY=
FINNHUB_POLL_INTERVAL_S=30
# Binance hosts. In the United States use wss://stream.binance.us:9443 and https://api.binance.us
# (binance.com refuses US addresses). data-stream.binance.vision / data-api.binance.vision are
# market-data-only mirrors.
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_REST_URL=https://api.binance.com

# --- Simulator ---
# Empty = random; any integer makes prices, volumes and injected faults reproducible.
SIM_SEED=
# Simulated market time per real second (1 = realistic intraday volatility).
SIM_SPEED=1
SIM_INTERVAL_MS=500
SIM_TICK_PROBABILITY=0.6
# Fraction of simulated events deliberately corrupted to exercise the data-quality layer.
SIM_FAULT_RATE=0.005
# Seed for the generated year of simulated history.
SEED_RANDOM_SEED=42

# --- Processing ---
ROLLING_WINDOW=20
BATCH_MAX=500
# Reject events stamped further in the future than this (tolerates host clock drift).
MAX_FUTURE_SKEW_S=30
MAX_EVENT_AGE_H=24
EVENT_RETENTION_DAYS=30
ERROR_RETENTION_DAYS=30
METRIC_RETENTION_DAYS=7
BAR_1M_RETENTION_DAYS=90

# --- API and WebSocket ---
# Browser origins allowed for REST (CORS) and WebSocket handshakes; same-origin is always allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
# Per client address.
RATE_LIMIT_PER_MINUTE=1200
WS_MAX_CONNECTIONS=200
WS_MAX_PER_CLIENT=20
# Messages buffered per WebSocket client before a slow client is disconnected (close 1013).
WS_QUEUE_SIZE=256
# Watchlists are shared and unauthenticated; bound how many can exist.
WATCHLIST_MAX=50
LOG_LEVEL=INFO
