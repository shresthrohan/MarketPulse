# MarketPulse — production configuration for one Linux host (docs/deployment.md).
# Copy to /opt/marketpulse/.env.production on the server, chmod 600, and NEVER commit it.
# The server is the only place this file exists; CI never sees these values.

# Public DNS name that points at the server (A record). Caddy obtains the HTTPS certificate for it.
# No domain? Use the IP with dashes on sslip.io, e.g. 203-0-113-7.sslip.io
PUBLIC_HOST=203-0-113-7.sslip.io

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=marketpulse
# Generate: openssl rand -hex 24   (letters and digits only: it is embedded in connection URLs)
POSTGRES_PASSWORD=
POSTGRES_DB=marketpulse

# --- Market data providers (see .env.example for the options) ---
PROVIDERS=simulator,binance
FINNHUB_API_KEY=
FINNHUB_POLL_INTERVAL_S=30
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_REST_URL=https://api.binance.com

# --- Simulator ---
SIM_SEED=
SIM_SPEED=1
SIM_INTERVAL_MS=500
SIM_TICK_PROBABILITY=0.6
SIM_FAULT_RATE=0.005
SEED_RANDOM_SEED=42

# --- Processing (retention sized for a 40 GB disk: ~0.5M events/day) ---
ROLLING_WINDOW=20
BATCH_MAX=500
MAX_FUTURE_SKEW_S=30
MAX_EVENT_AGE_H=24
EVENT_RETENTION_DAYS=7
ERROR_RETENTION_DAYS=14
METRIC_RETENTION_DAYS=7
BAR_1M_RETENTION_DAYS=30

# --- API and WebSocket (public internet: tighter per-client limits) ---
# CORS is derived from PUBLIC_HOST by docker-compose.prod.yml.
RATE_LIMIT_PER_MINUTE=600
WS_MAX_CONNECTIONS=200
WS_MAX_PER_CLIENT=5
WS_QUEUE_SIZE=256
WATCHLIST_MAX=50
LOG_LEVEL=INFO
